{
  "id": "smb",
  "name": "SMB Config",
  "description": "Configure Samba network file shares and user credentials",
  "category": "Storage",
  "default": false,
  "apt_package": "samba",
  "check_cmd": "which smbd",
  "install_cmd": "apt-get update && apt-get install -y samba",
  "install_sudo": "apt-get update && apt-get install -y samba",
  "remove_cmd": "apt-get remove -y samba",
  "remove_sudo": "apt-get remove -y samba",
  "commands": {
    "restart_smb_sudo": "systemctl restart smbd || service smbd restart",
    "status_smb_cmd": "systemctl status smbd || service smbd status",
    "add_smb_user_sudo": "useradd -s /bin/false {username} 2>/dev/null || true; printf '%s\\n%s\\n' '{password}' '{password}' | smbpasswd -a -s {username} && smbpasswd -e {username}"
  }
}
