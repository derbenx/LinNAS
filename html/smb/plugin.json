{
  "id": "smb",
  "name": "SMB Shares & User Config",
  "description": "Configure Samba shares, network permissions, and user accounts",
  "category": "Storage",
  "default": false,
  "apt_package": "samba",
  "check_cmd": "which smbd",
  "install_sudo": "apt-get update && apt-get install -y samba samba-common-bin",
  "remove_sudo": "apt-get remove -y samba",
  "commands": {
    "add_smb_user_sudo": "(id -u \"{username}\" >/dev/null 2>&1 || useradd -M -s /usr/sbin/nologin \"{username}\") && (echo \"{password}\"; echo \"{password}\") | smbpasswd -a -s \"{username}\"",
    "delete_smb_user_sudo": "smbpasswd -x \"{username}\"",
    "list_smb_users_sudo": "pdbedit -L 2>/dev/null | cut -d: -f1 || (test -f /etc/samba/smbpasswd && cut -d: -f1 /etc/samba/smbpasswd) || true",
    "restart_smb_sudo": "systemctl restart smbd || service smbd restart"
  }
}
