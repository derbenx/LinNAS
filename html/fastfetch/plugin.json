{
  "id": "fastfetch",
  "name": "Fastfetch System Info",
  "description": "Display Debian system summary, OS version, kernel, uptime, packages, and ASCII art logo",
  "category": "System",
  "default": false,
  "apt_package": "fastfetch",
  "check_cmd": "which fastfetch",
  "install_sudo": "apt-get update && apt-get install -y fastfetch",
  "remove_sudo": "apt-get purge -y fastfetch 2>/dev/null; true",
  "commands": {
    "fastfetch_cmd": "fastfetch 2>/dev/null"
  }
}
