{
  "id": "settings",
  "name": "Server Settings",
  "description": "Configure server hostname, port, power controls, and admin account password",
  "category": "System",
  "default": true,
  "commands": {
    "get_hostname_cmd": "hostname",
    "set_hostname_sudo": "OLD_HN=$(hostname); (hostnamectl set-hostname \"{hostname}\" || hostname \"{hostname}\") && echo \"{hostname}\" > /etc/hostname && sed -i \"s/\\b$OLD_HN\\b/{hostname}/g\" /etc/hosts",
    "poweroff_sudo": "shutdown -h now",
    "reboot_sudo": "reboot",
    "restart_app_sudo": "systemctl restart linnas 2>/dev/null || (pkill -f linnas && nohup /usr/local/bin/linnas >/dev/null 2>&1 &)",
    "quit_app_sudo": "systemctl stop linnas 2>/dev/null || pkill -f linnas || killall linnas",
    "schedule_poweroff_sudo": "shutdown -h +{minutes}",
    "schedule_reboot_sudo": "shutdown -r +{minutes}",
    "cancel_shutdown_sudo": "shutdown -c"
  }
}
