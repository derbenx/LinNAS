{
  "id": "veracrypt",
  "name": "VeraCrypt Config",
  "description": "Mount and dismount encrypted VeraCrypt volume containers",
  "category": "Storage",
  "default": false,
  "apt_package": "veracrypt",
  "check_cmd": "which veracrypt",
  "install_sudo": "apt-get update && apt-get install -y veracrypt",
  "remove_sudo": "apt-get remove -y veracrypt",
  "commands": {
    "mount_volume_sudo": "veracrypt -t -k \"\" --paging=no --non-interactive \"{volume_path}\" \"{mount_point}\" --password=\"{password}\"",
    "dismount_volume_sudo": "veracrypt -d \"{mount_point}\"",
    "dismount_all_sudo": "veracrypt -d"
  }
}
