{
  "id": "drive_mount",
  "name": "Drives, ISO & VHD",
  "description": "Mount local disk partitions, ISO images, and VHD disk files into filesystem",
  "category": "Storage",
  "default": true,
  "commands": {
    "list_drives_cmd": "lsblk -J -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT",
    "mount_disk_cmd": "mkdir -p {mountpoint} && mount {device} {mountpoint}",
    "unmount_disk_cmd": "umount {mountpoint}",
    "mount_iso_cmd": "mkdir -p {mountpoint} && mount -o loop {filepath} {mountpoint}",
    "mount_vhd_cmd": "mkdir -p {mountpoint} && mount -o loop {filepath} {mountpoint}"
  }
}
