{
  "id": "drive_mount",
  "name": "Drives, ISO & VHD",
  "description": "Mount local disk partitions, ISO images, and VHD disk files into filesystem",
  "category": "Storage",
  "default": true,
  "commands": {
    "list_drives_cmd": "lsblk -J -o NAME,SIZE,TYPE,FSTYPE,LABEL,UUID,MOUNTPOINT",
    "mount_disk_sudo": "mkdir -p \"{mountpoint}\" && mount \"{device}\" \"{mountpoint}\"",
    "unmount_disk_sudo": "umount \"{mountpoint}\"",
    "mount_iso_sudo": "mkdir -p \"{mountpoint}\" && mount -o loop \"{filepath}\" \"{mountpoint}\"",
    "mount_vhd_sudo": "mkdir -p \"{mountpoint}\" && mount -o loop \"{filepath}\" \"{mountpoint}\""
  }
}
